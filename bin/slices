#!/usr/bin/env bash
# slices — trabajo por slices con agentes hijos, para cualquier repo git.
#
# Un archivo solo. Copialo a la raíz de tu proyecto (o a tu PATH) y:
#
#   ./slices init                      # deja slices.conf, AGENTS.md y la carpeta de specs
#   ./slices nuevo login "Login con clave"   # crea specs/NNN-login.spec.md para completar
#   ./slices lanzar 001-login          # un agente hijo lo trabaja en su propia copia del repo
#   ./slices lanzar 001-login 002-pagos 003-informes   # varios en paralelo
#   ./slices estado                    # quién corre, quién terminó, quién cerró
#   ./slices verificar 001-login       # corre los chequeos por fuera y deja el recibo
#   ./slices mergear 001-login         # entra a la rama base solo si el recibo cerró
#   ./slices dag [--mermaid]           # el grafo: dependencias, olas que corren en paralelo y estado
#   ./slices auto [<id>…]              # el loop entero solo: lanza por dependencias, verifica,
#                                      # relanza con el motivo y mergea (según MODO)
#
# Con LANZADOR="orca" en slices.conf, `lanzar` no corre el agente acá: le pide a
# Orca un worker supervisado (`orca orchestration worker-start`) en el worktree
# del slice. Orca pone la UI, ask/reply, heartbeats y gates; slices pone el SPEC,
# la verificación por fuera, el juez y el merge. Cuando llega el `worker_done`,
# el coordinador corre `./slices verificar <id>`: Orca le cree al worker, slices no.
#
# Si un slice NO cerró, volver a lanzarlo le pasa al agente el motivo y el
# veredicto del juez para que arregle eso, sobre lo que ya escribió.
#
# La idea, en cuatro reglas:
#   1. El pedido se escribe: cada slice tiene un SPEC con alcance de archivos y
#      tests exigidos. Sin SPEC no se lanza nada.
#   2. Un hijo por slice, cada uno en su worktree y su rama: no se pisan.
#   3. No se le cree al que ejecuta: los chequeos se corren de nuevo por fuera.
#      "Listo" sin recibo verde no cierra.
#   4. Lo que tiene que seguir vivo se lanza desacoplado de la terminal.
#
# Necesita: git, bash 4+, y el CLI del ejecutor que elijas (cursor-agent,
# claude o codex) con la sesión iniciada.

set -euo pipefail

RAIZ="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "$RAIZ" ]] || { echo "slices: corré esto adentro de un repo git" >&2; exit 2; }
YO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
NOMBRE_REPO="$(basename "$RAIZ")"

# ── configuración: estos son los valores por defecto; slices.conf los pisa ──
BASE="$(git -C "$RAIZ" symbolic-ref --short HEAD 2>/dev/null || echo main)"  # rama a la que se mergea
SPECS="specs"                                    # dónde viven los SPEC
RECIBOS="recibos"                                # dónde queda la evidencia
WORKTREES="$RAIZ/.slices"                        # una carpeta por slice, adentro del repo e ignorada:
                                                 # así heredan la confianza de la carpeta (Claude Code,
                                                 # Cursor) y el agente no se frena preguntando en cada slice
EJECUTOR="cursor"                                # cursor | claude | codex | cmd (EJECUTOR_CMD)
MODELO=""                                        # vacío = el default del CLI
LANZADOR="local"                                 # local: el hijo corre acá · orca: worker supervisado de Orca
AGENTE_ORCA="cursor"                             # con LANZADOR=orca: agente de Orca (cursor = cursor-agent, claude, codex, grok = CLI de xAI)
JUEZ=""                                          # vacío = solo chequeos · "jev" = Jev (TypeSafe) · "claude" = un modelo
MODELO_JUEZ="sonnet"
MAX_PARALELO=3                                   # cuántos hijos a la vez (una máquina chica no aguanta más)
MODO="semi"                                      # para `auto`: auto = mergea solo · semi = frena antes de cada
                                                 # merge para revisar el diff · manual = no usar `auto`
MAX_INTENTOS=3                                   # rechazos seguidos antes de pasarle el slice a una persona
CHECKS=()                                        # "nombre::comando"; `init` los detecta
PREPARAR=""                                      # comando que corre una vez en cada worktree (npm install…)
[[ -f "$RAIZ/slices.conf" ]] && source "$RAIZ/slices.conf"
# Las variables de entorno ganan, para probar algo una sola vez.
EJECUTOR="${SLICES_EJECUTOR:-$EJECUTOR}"; MODELO="${SLICES_MODELO:-$MODELO}"
LANZADOR="${SLICES_LANZADOR:-$LANZADOR}"; AGENTE_ORCA="${SLICES_AGENTE_ORCA:-$AGENTE_ORCA}"; MODO="${SLICES_MODO:-$MODO}"
JUEZ_JEV="$(dirname "$YO")/juez-jev"; [[ -x "$JUEZ_JEV" ]] || JUEZ_JEV="$(command -v juez-jev || true)"

morir() { echo "slices: $*" >&2; exit 2; }
wt_de() { echo "$WORKTREES/$1"; }
spec_de() { echo "$RAIZ/$SPECS/$1.spec.md"; }
unidad_de() { echo "slice-$NOMBRE_REPO-$1" | sed 's/[^A-Za-z0-9_.-]/-/g'; }

corriendo() {  # ¿el hijo de este slice sigue vivo?
  local id="$1" pidf; pidf="$(wt_de "$id")/$RECIBOS/$id/pid"
  if command -v systemctl >/dev/null 2>&1 && systemctl --user is-active -q "$(unidad_de "$id")" 2>/dev/null; then return 0; fi
  [[ -f "$pidf" ]] && kill -0 "$(cat "$pidf")" 2>/dev/null
}

# ── init ────────────────────────────────────────────────────────────────────
cmd_init() {
  mkdir -p "$RAIZ/$SPECS" "$RAIZ/$RECIBOS"
  if [[ ! -f "$RAIZ/slices.conf" ]]; then
    local c=()
    [[ -f "$RAIZ/Cargo.toml" ]]     && c+=('"build::cargo build --workspace"' '"tests::cargo test --workspace"')
    [[ -f "$RAIZ/package.json" ]]   && c+=('"tests::npm test --silent"')
    [[ -f "$RAIZ/pyproject.toml" || -f "$RAIZ/pytest.ini" ]] && c+=('"tests::python -m pytest -q"')
    [[ -f "$RAIZ/go.mod" ]]         && c+=('"build::go build ./..."' '"tests::go test ./..."')
    [[ ${#c[@]} -eq 0 ]] && c+=('"tests::echo CAMBIAME: poné acá el comando de tus tests; exit 1"')
    local lanzador="local" juez=""
    command -v orca >/dev/null 2>&1 && lanzador="orca"
    [[ -n "${JEV_API_KEY:-}" || -f "$HOME/.config/kit-orquestacion/jev.key" || -f "$HOME/.config/aos/jev.key" ]] && juez="jev"
    cat > "$RAIZ/slices.conf" <<EOF
# Configuración de ./slices. Es bash: se lee con \`source\`.
BASE="$BASE"                 # rama a la que se mergea cada slice
LANZADOR="$lanzador"           # local | orca (worker supervisado de Orca)
AGENTE_ORCA="cursor"         # con orca: cursor (cursor-agent) | claude | codex | grok (CLI de xAI)
EJECUTOR="cursor"            # con local: cursor | claude | codex
MODELO=""                    # vacío = el default del agente
JUEZ="$juez"                 # jev | claude | vacío (solo chequeos)
MODO="semi"                  # ./slices auto: auto (mergea solo) | semi (frena antes de mergear) | manual
MAX_PARALELO=3               # hijos a la vez
PREPARAR=""                  # se corre en cada worktree nuevo, con $RAIZ = este repo (ej. "npm ci")
# Lo que tiene que pasar para que un slice cierre. "nombre::comando".
CHECKS=(
$(printf '  %s\n' "${c[@]}")
)
EOF
    echo "creado slices.conf (revisá CHECKS)"
  fi
  if ! grep -q "slices:reglas" "$RAIZ/AGENTS.md" 2>/dev/null; then
    cat >> "$RAIZ/AGENTS.md" <<EOF

<!-- slices:reglas -->
## Cómo se trabaja en este repo (slices)

- El trabajo se parte en slices. Cada uno tiene un SPEC en \`$SPECS/<id>.spec.md\`.
- Trabajá en el directorio donde estás parado: es el worktree de tu slice. No
  escribas en otro checkout.
- No toques archivos fuera del "Alcance de archivos" de tu SPEC. Si hace
  falta, decilo en el recibo: no lo hagas en silencio.
- Un slice está hecho cuando pasan los chequeos de \`slices.conf\` y están los
  tests que el SPEC exige. Los chequeos se vuelven a correr por fuera.
- Terminá con un recibo: qué hiciste, qué archivos tocaste, qué corriste y con
  qué resultado, y qué NO quedó (gaps). Si no tenés certeza, no digas "listo".
- No hagas \`git commit\`, \`git push\` ni cambies de rama: de eso se ocupa \`./slices\`.
<!-- /slices:reglas -->
EOF
    echo "agregadas las reglas a AGENTS.md"
  fi
  [[ -f "$RAIZ/CLAUDE.md" ]] || { echo "@AGENTS.md" > "$RAIZ/CLAUDE.md"; echo "creado CLAUDE.md"; }
  grep -qxF "$RECIBOS/*/pid" "$RAIZ/.gitignore" 2>/dev/null || echo "$RECIBOS/*/pid" >> "$RAIZ/.gitignore"
  grep -qxF "$RECIBOS/.orca-run" "$RAIZ/.gitignore" 2>/dev/null || echo "$RECIBOS/.orca-run" >> "$RAIZ/.gitignore"
  grep -qxF ".slices/" "$RAIZ/.gitignore" 2>/dev/null || echo ".slices/" >> "$RAIZ/.gitignore"
  echo "listo. Siguiente: ./slices nuevo <nombre> \"<título>\""
}

# ── nuevo ───────────────────────────────────────────────────────────────────
cmd_nuevo() {
  local nombre="${1:?uso: slices nuevo <nombre-corto> \"<título>\"}" titulo="${2:-$1}"
  # El número se elige mirando también el remoto: dos personas (o dos sesiones)
  # numerando a la vez sobre copias viejas terminan con el mismo número.
  git -C "$RAIZ" fetch -q 2>/dev/null || true
  local ultimo
  ultimo=$( { ls "$RAIZ/$SPECS" 2>/dev/null; git -C "$RAIZ" ls-tree -r --name-only "origin/$BASE" -- "$SPECS" 2>/dev/null | xargs -rn1 basename; } \
            | grep -oE '^[0-9]{3}' | sort -n | tail -1 || true)
  local n; n=$(printf '%03d' $(( 10#${ultimo:-0} + 1 )))
  local id="$n-$nombre" f; f="$(spec_de "$n-$nombre")"
  mkdir -p "$RAIZ/$SPECS"
  cat > "$f" <<EOF
# Slice $n — $titulo

**Depende de:** (ids de otros slices, o "nada")
**Fuente:** (quién lo pidió y con qué palabras)
**Alcance de archivos:** \`ruta/uno\`, \`ruta/dos\` (lo único que el agente puede tocar)

## Por qué

(Qué pasa hoy y qué problema concreto resuelve. Dos párrafos.)

## Qué tiene que pasar

1. (Comportamiento, con el caso borde dicho.)

## Tests exigidos

1. (Un test por comportamiento: qué se le da y qué tiene que dar.)

## Criterios de aceptación

- [ ] Pasan los chequeos de \`slices.conf\`.

## Fuera de alcance

(Lo que parece parte de esto y no lo es.)
EOF
  echo "$f"
  echo "completalo, commitealo (así el número queda tomado) y: ./slices lanzar $id"
}

# ── lanzar ──────────────────────────────────────────────────────────────────
armar_prompt() {
  local id="$1"
  cat <<EOF
Sos el ejecutor del slice $id de este repo. Estás parado en el worktree del
slice: trabajá acá y solo acá.

Leé AGENTS.md y seguí sus reglas. Implementá el SPEC que sigue, completo:
el código, y los tests que exige. Corré los chequeos del proyecto antes de
terminar y arreglá lo que rompas.

No hagas git commit ni git push. No toques archivos fuera del alcance.

Terminá tu respuesta con este bloque, honesto:

===RECIBO===
hecho: <qué quedó implementado>
archivos: <lista>
chequeos: <qué corriste y con qué resultado>
gaps: <qué NO quedó o no pudiste verificar; "ninguno" solo si es verdad>
===FIN===

Guardá ese mismo bloque en $RECIBOS/$id/recibo-agente.md antes de terminar.
$( [[ -s "$(wt_de "$id")/$RECIBOS/$id/reintento.txt" ]] && { echo; cat "$(wt_de "$id")/$RECIBOS/$id/reintento.txt"; } )

──────────── SPEC ────────────
$(cat "$(spec_de "$id")")
EOF
}

ejecutar_agente() {  # corre el CLI del ejecutor en el worktree, en primer plano
  local wt="$1" prompt="$2"
  case "$EJECUTOR" in
    cursor) cursor-agent --print --force --trust ${MODELO:+--model "$MODELO"} --workspace "$wt" --output-format text "$prompt" ;;
    claude) (cd "$wt" && claude -p "$prompt" ${MODELO:+--model "$MODELO"} --dangerously-skip-permissions) ;;
    codex)  (cd "$wt" && codex exec --dangerously-bypass-approvals-and-sandbox ${MODELO:+-m "$MODELO"} "$prompt") ;;
    # Cualquier otro CLI (o un falso para probar): EJECUTOR_CMD recibe el prompt en $SLICES_PROMPT.
    cmd)    (cd "$wt" && SLICES_PROMPT="$prompt" bash -c "${EJECUTOR_CMD:?EJECUTOR=cmd necesita EJECUTOR_CMD}") ;;
    *) echo "EJECUTOR desconocido: $EJECUTOR" >&2; return 2 ;;
  esac
}

# Si el intento anterior no cerró, el próximo prompt lleva el motivo y el juez.
preparar_reintento() {
  local id="$1" out; out="$(wt_de "$id")/$RECIBOS/$id"
  rm -f "$out/reintento.txt"
  [[ -f "$out/recibo.json" ]] && ! grep -q '"cerrado": true' "$out/recibo.json" || return 0
  {
    echo "──────────── INTENTO ANTERIOR: NO CERRÓ ────────────"
    echo "Motivo: $(grep -oP '"motivo": "\K[^"]*' "$out/recibo.json")"
    [[ -s "$out/juez.txt" ]] && { echo "Veredicto del juez:"; cat "$out/juez.txt"; }
    [[ -s "$out/chequeos.log" ]] && grep -q 'ok=false' "$out/chequeos.log" && { echo "Últimas líneas de los chequeos:"; tail -40 "$out/chequeos.log"; }
    echo "Seguí sobre lo que ya está escrito en este worktree y arreglá exactamente eso."
  } > "$out/reintento.txt"
  mv "$out/recibo.json" "$out/recibo.anterior.json"
  rm -f "$out/recibo-agente.md"
}

# Worker supervisado de Orca en el worktree del slice. Un Run por repo.
lanzar_en_orca() {
  local id="$1" wt="$2" out run; out="$wt/$RECIBOS/$id"
  command -v orca >/dev/null 2>&1 || morir "LANZADOR=orca pero no está el CLI de orca"
  run=$(orca orchestration run-current --json 2>/dev/null | jq -r '.result.run.id // .result.run.runId // empty' || true)
  [[ -n "$run" ]] || run=$(cat "$RAIZ/$RECIBOS/.orca-run" 2>/dev/null || true)
  if [[ -z "$run" ]]; then
    run=$(orca orchestration run-create --objective "slices de $NOMBRE_REPO" --json \
          | jq -r '.result.run.id // .result.run.runId // .result.id // .result.runId // empty')
    [[ -n "$run" ]] || morir "no pude crear el Run de Orca"
  fi
  mkdir -p "$RAIZ/$RECIBOS"; echo "$run" > "$RAIZ/$RECIBOS/.orca-run"
  if ! orca orchestration worker-start --spec "$(cat "$out/prompt.txt")" --task-title "slice $id" \
        --worktree "path:$wt" --agent "$AGENTE_ORCA" ${MODELO:+--model "$MODELO"} --run "$run" --json \
        > "$out/orca-start.json" 2>&1; then
    cat "$out/orca-start.json" >&2; morir "worker-start falló para $id (no relanzar a ciegas: ver $out/orca-start.json)"
  fi
  jq -r '.result.dispatchId // .result.dispatch.id // empty' "$out/orca-start.json" > "$out/orca-dispatch"
  echo "$id: worker de Orca ($AGENTE_ORCA${MODELO:+ $MODELO}) · dispatch $(cat "$out/orca-dispatch") · run $run"
  echo "   al llegar su worker_done: ./slices verificar $id"
}

cmd_lanzar() {
  local dry=""; local ids=()
  for a in "$@"; do [[ "$a" == "--dry-run" ]] && dry=1 || ids+=("$a"); done
  [[ ${#ids[@]} -gt 0 ]] || morir "uso: slices lanzar <id> [<id>…] [--dry-run]"
  for id in "${ids[@]}"; do
    [[ -f "$(spec_de "$id")" ]] || morir "no existe $(spec_de "$id")"
    if corriendo "$id"; then echo "$id: ya hay un hijo corriendo"; continue; fi
    # Lanzar a mano un slice escalado es la decisión de la persona: vuelve al loop desde cero.
    rm -f "$(wt_de "$id")/$RECIBOS/$id/escalado" "$(wt_de "$id")/$RECIBOS/$id/intentos"
    # Tope de hijos a la vez: se espera lugar en vez de saturar la máquina.
    # Con Orca no: Orca lleva la cuenta de sus workers.
    [[ "$LANZADOR" == orca ]] || while (( $(cmd_estado --corriendo | wc -l) >= MAX_PARALELO )); do sleep 15; done
    local wt; wt="$(wt_de "$id")"
    if [[ ! -d "$wt" ]]; then
      mkdir -p "$WORKTREES"
      if git -C "$RAIZ" show-ref -q --verify "refs/heads/slice-$id"; then
        git -C "$RAIZ" worktree add -q "$wt" "slice-$id"
      else
        git -C "$RAIZ" worktree add -q -b "slice-$id" "$wt" "$BASE"
      fi
      if [[ -n "$PREPARAR" ]]; then
        # El log va al lado del worktree (no adentro: `git add -A` lo commitearía).
        local plog="$WORKTREES/$id.preparar.log"
        (cd "$wt" && RAIZ="$RAIZ" bash -c "$PREPARAR") > "$plog" 2>&1 \
          || { git -C "$RAIZ" worktree remove --force "$wt" 2>/dev/null
               morir "$id: falló PREPARAR (ver $plog). Saqué el worktree para que el próximo intento arranque limpio"; }
      fi
    fi
    # El SPEC que manda es el de la rama base: si lo corregiste, el hijo lo ve.
    mkdir -p "$wt/$SPECS" "$wt/$RECIBOS/$id"
    cp "$(spec_de "$id")" "$wt/$SPECS/"
    preparar_reintento "$id"
    armar_prompt "$id" > "$wt/$RECIBOS/$id/prompt.txt"
    if [[ -n "$dry" ]]; then echo "$id: [dry-run] prompt en $wt/$RECIBOS/$id/prompt.txt"; continue; fi
    if [[ "$LANZADOR" == orca ]]; then lanzar_en_orca "$id" "$wt"; continue; fi
    # Desacoplado de esta terminal: si se cierra la sesión, el hijo sigue.
    if command -v systemd-run >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
      systemctl --user reset-failed "$(unidad_de "$id")" 2>/dev/null || true
      systemd-run --user --quiet --unit="$(unidad_de "$id")" --working-directory="$RAIZ" \
        -E PATH="$PATH" -E HOME="$HOME" -E SLICES_EJECUTOR="$EJECUTOR" -E SLICES_MODELO="$MODELO" \
        "$YO" _trabajar "$id"
    else
      (cd "$RAIZ" && setsid nohup "$YO" _trabajar "$id" >/dev/null 2>&1 < /dev/null & echo $! > "$wt/$RECIBOS/$id/pid")
    fi
    echo "$id: lanzado ($EJECUTOR${MODELO:+ $MODELO}) en $wt"
  done
  [[ -n "$dry" ]] || echo "seguilos con: ./slices estado   ·   log: <worktree>/$RECIBOS/<id>/agente.log"
}

# Lo que corre el hijo desacoplado: el agente, y después la verificación.
cmd__trabajar() {
  local id="$1" wt; wt="$(wt_de "$id")"; local out="$wt/$RECIBOS/$id"
  echo $$ > "$out/pid"
  set +e
  ejecutar_agente "$wt" "$(cat "$out/prompt.txt")" > "$out/agente.log" 2>&1
  echo "$?" > "$out/agente.exit"
  set -e
  cmd_verificar "$id" > "$out/verificar.log" 2>&1 || true
  rm -f "$out/pid"
}

# ── verificar ───────────────────────────────────────────────────────────────
cmd_verificar() {
  local id="${1:?uso: slices verificar <id>}" wt; wt="$(wt_de "$id")"
  [[ -d "$wt" ]] || morir "no existe el worktree $wt"
  [[ ${#CHECKS[@]} -gt 0 ]] || morir "no hay CHECKS en slices.conf: sin chequeos nada puede cerrar"
  local out="$wt/$RECIBOS/$id"; mkdir -p "$out"; : > "$out/chequeos.log"
  local todo_ok=true json_checks=""
  for c in "${CHECKS[@]}"; do
    local nombre="${c%%::*}" comando="${c#*::}" ok=true
    { echo "### $nombre: $comando"; (cd "$wt" && bash -c "$comando") 2>&1 || ok=false; echo "### fin $nombre (ok=$ok)"; echo; } >> "$out/chequeos.log"
    $ok || todo_ok=false
    json_checks+="${json_checks:+, }\"$nombre\": $ok"
    echo "  $nombre: $($ok && echo pasa || echo FALLA)"
  done
  # Lo que cambió contra la base, sin contar la evidencia.
  git -C "$wt" add -A >/dev/null 2>&1
  # Contra el punto donde nació la rama, no contra la base de hoy: si la base
  # avanzó, sus cambios aparecerían como "tocados" por el slice.
  local desde; desde=$(git -C "$wt" merge-base "$BASE" HEAD)
  local tocados; tocados=$(git -C "$wt" diff --cached --name-only "$desde" -- . ":!$RECIBOS" | wc -l)
  git -C "$wt" diff --cached --stat "$desde" -- . ":!$RECIBOS" > "$out/diff.stat"
  # "Verde" sin trabajo hecho es un falso positivo: el repo ya pasaba antes.
  local cerrado=$todo_ok motivo=""
  (( tocados > 0 )) || { cerrado=false; motivo="no tocó ningún archivo"; }
  grep -qs '===RECIBO===' "$out/agente.log" "$out/recibo-agente.md" || { cerrado=false; motivo="${motivo:+$motivo; }el agente no dejó recibo"; }
  $todo_ok || motivo="${motivo:+$motivo; }fallan chequeos (ver chequeos.log)"
  local veredicto="sin juez"
  if $cerrado && [[ "$JUEZ" == "jev" ]]; then
    [[ -n "$JUEZ_JEV" ]] || morir "JUEZ=jev pero no encuentro juez-jev (va al lado de slices o en el PATH)"
    veredicto=$("$JUEZ_JEV" "$(spec_de "$id")" "$wt" "$desde" 2>&1) || true
    echo "$veredicto" > "$out/juez.txt"
    # Un juez que no contesta no es un chequeo que pasó.
    [[ "$(head -1 <<<"$veredicto")" == CIERRA ]] || { cerrado=false; motivo="${motivo:+$motivo; }Jev no cierra (ver juez.txt)"; }
    veredicto="jev: $(head -1 <<<"$veredicto")"
  elif $cerrado && [[ "$JUEZ" == "claude" ]]; then
    veredicto=$( (cd "$wt" && claude -p "Sos el juez de un slice. Abajo van el SPEC y el diff. Respondé en la PRIMERA línea solo CIERRA o NO CIERRA, y después, uno por línea, cada test exigido o criterio del SPEC que NO esté cubierto por el diff. Juzgá por el sentido, no por el nombre del test.

SPEC:
$(cat "$(spec_de "$id")")

DIFF:
$(git -C "$wt" diff --cached "$desde" -- . ":!$RECIBOS" | head -c 120000)" --model "$MODELO_JUEZ" 2>/dev/null) || echo "NO RESPONDIÓ")
    echo "$veredicto" > "$out/juez.txt"
    # Un juez que no contesta no es un chequeo que pasó.
    [[ "$(head -1 <<<"$veredicto")" == CIERRA* ]] || { cerrado=false; motivo="${motivo:+$motivo; }el juez no cierra (ver juez.txt)"; }
    veredicto="$(head -1 <<<"$veredicto")"
  fi
  cat > "$out/recibo.json" <<EOF
{
  "slice": "$id",
  "ejecutor": "$EJECUTOR",
  "modelo": "${MODELO:-default}",
  "base": "$(git -C "$RAIZ" rev-parse --short "$BASE")",
  "verificado": "$(date -Iseconds)",
  "chequeos": { $json_checks },
  "archivos_tocados": $tocados,
  "juez": "$veredicto",
  "cerrado": $cerrado,
  "motivo": "$motivo"
}
EOF
  echo "── $id: $($cerrado && echo CIERRA || echo "NO CIERRA — $motivo")  ($tocados archivos)"
  $cerrado
}

# ── estado ──────────────────────────────────────────────────────────────────
ids_de_specs() { local f; for f in "$RAIZ/$SPECS"/*.spec.md; do [[ -e "$f" ]] && basename "$f" .spec.md; done; }

# Estado de un slice como código: mergeado escalado corriendo orca cerro nocerro cortado sinlanzar
estado_de() {
  local id="$1" wt; wt="$(wt_de "$id")"; local out="$wt/$RECIBOS/$id" r="$wt/$RECIBOS/$id/recibo.json"
  # Sin `| grep -q`: con pipefail, grep corta antes y git log muere por SIGPIPE.
  if [[ -n "$(git -C "$RAIZ" log -1 --format=%h -F --grep="merge slice $id " "$BASE" 2>/dev/null)" ]]; then echo mergeado
  elif [[ -s "$out/escalado" ]]; then echo escalado
  elif corriendo "$id"; then echo corriendo
  elif [[ -f "$r" ]] && grep -q '"cerrado": true' "$r"; then echo cerro
  elif [[ -f "$r" ]]; then echo nocerro
  elif [[ -s "$out/orca-dispatch" ]]; then echo orca
  elif [[ -d "$wt" ]]; then echo cortado
  else echo sinlanzar; fi
}

cmd_estado() {
  local solo="${1:-}" id e wt out
  while read -r id; do
    [[ -n "$id" ]] || continue
    wt="$(wt_de "$id")"; out="$wt/$RECIBOS/$id"; e="$(estado_de "$id")"
    if [[ "$solo" == "--corriendo" ]]; then [[ "$e" == corriendo ]] && echo "$id"; continue; fi
    case "$e" in
      cerro)    e="cerró — falta mergear" ;;
      nocerro)  e="NO cerró: $(grep -oP '"motivo": "\K[^"]*' "$out/recibo.json")" ;;
      escalado) e="ESCALADO: $(cat "$out/escalado")" ;;
      orca)     e="en Orca (dispatch $(cat "$out/orca-dispatch")); al worker_done: verificar" ;;
      cortado)  e="cortado a medias (relanzar: sigue sobre lo escrito)" ;;
      sinlanzar) e="sin lanzar" ;;
    esac
    printf '%-34s %s\n' "$id" "$e"
  done < <(ids_de_specs)
}

# ── auto ────────────────────────────────────────────────────────────────────
# Ids de los que depende un slice, leídos de "**Depende de:**" (acepta 002 o 002-pagos).
deps_de() {
  local linea n; linea=$(grep -m1 -oP '\*\*Depende de:\*\*\K.*' "$(spec_de "$1")" 2>/dev/null || true)
  local m
  for n in $(grep -oE '\b[0-9]{3}\b' <<<"$linea"); do
    # awk lee todo (sin cortar el pipe): con pipefail, un `grep -m1` haría fallar al productor.
    m=$(ids_de_specs | awk -v p="^$n-" '$0 ~ p && !x { print; x = 1 }')
    echo "${m:-$n-desconocido}"
  done
}
deps_listas() { local d; for d in $(deps_de "$1"); do [[ "$(estado_de "$d")" == mergeado ]] || return 1; done; }
escalar() {
  local id="$1" motivo="$2" out; out="$(wt_de "$id")/$RECIBOS/$id"
  mkdir -p "$out"; echo "$motivo" > "$out/escalado"
  echo "⚠ $id ESCALADO: $motivo"
}

# Mensajes de Orca: verifica cada worker_done; preguntas y escalamientos frenan el loop.
procesar_orca() {
  local run="$1" resp msgs n i tipo disp id f frenar=""
  resp=$(orca orchestration check --run "$run" --wait --types "worker_done,escalation,question" \
         --timeout-ms 600000 --json 2>/dev/null) || return 0
  n=$(jq '.result.messages | length' <<<"$resp" 2>/dev/null || echo 0)
  for (( i=0; i<n; i++ )); do
    tipo=$(jq -r ".result.messages[$i].type" <<<"$resp")
    if [[ "$tipo" == worker_done ]]; then
      disp=$(jq -r ".result.messages[$i].payload | fromjson? | .dispatchId // empty" <<<"$resp")
      id=""; for f in "$WORKTREES"/*/"$RECIBOS"/*/orca-dispatch; do [[ -f "$f" && "$(cat "$f")" == "$disp" ]] && id=$(basename "$(dirname "$f")"); done
      [[ -n "$id" && "$(estado_de "$id")" == orca ]] || continue
      echo "── worker_done de $id: verificando por fuera"
      cmd_verificar "$id" || true
      orca orchestration worker-release --dispatch "$disp" --json >/dev/null 2>&1 || true
    else
      frenar=1
      echo "── el worker necesita al coordinador ($tipo):"
      jq -r ".result.messages[$i] | \"   id: \(.id // \"?\")\n   \(.subject // \"\")\n   \(.body // \"\")\"" <<<"$resp"
    fi
  done
  if [[ -n "$frenar" ]]; then
    echo "   Contestá con: orca orchestration reply --id <id> --body \"…\"  y volvé a correr ./slices auto"
    return 3
  fi
  local delivery; delivery=$(jq -r '.result.deliveryId // empty' <<<"$resp")
  [[ -z "$delivery" ]] || orca orchestration check --run "$run" --ack "$delivery" --json >/dev/null 2>&1 || true
}

# El DAG: cada slice con sus dependencias, agrupado en olas (todo lo de una ola
# puede correr en paralelo). Avisa dependencias que no existen y ciclos.
cmd_dag() {
  local mermaid="${1:-}" id d ids=() falta=0
  mapfile -t ids < <(ids_de_specs)
  (( ${#ids[@]} )) || morir "no hay SPECs en $SPECS"
  declare -A ola=() deps=()
  for id in "${ids[@]}"; do
    deps[$id]="$(deps_de "$id" | tr '\n' ' ')"
    for d in ${deps[$id]}; do [[ "$d" == *-desconocido ]] && { echo "⚠ $id depende de ${d%-desconocido}, que no existe"; falta=1; }; done
  done
  # Olas: un slice va en la ola siguiente a la más alta de sus dependencias.
  local cambio=1 n max
  while (( cambio )); do
    cambio=0
    for id in "${ids[@]}"; do
      [[ -n "${ola[$id]:-}" ]] && continue
      max=0
      for d in ${deps[$id]}; do
        [[ "$d" == *-desconocido ]] && continue
        [[ -n "${ola[$d]:-}" ]] || { max=-1; break; }
        (( ola[$d] > max )) && max=${ola[$d]}
      done
      (( max >= 0 )) && { ola[$id]=$((max + 1)); cambio=1; }
    done
  done
  for id in "${ids[@]}"; do [[ -n "${ola[$id]:-}" ]] || { echo "⚠ $id está en un ciclo de dependencias"; falta=1; }; done

  if [[ "$mermaid" == --mermaid ]]; then
    echo "graph LR"
    for id in "${ids[@]}"; do
      echo "  s${id%%-*}[\"$id<br/>$(estado_de "$id")\"]"
      for d in ${deps[$id]}; do [[ "$d" == *-desconocido ]] || echo "  s${d%%-*} --> s${id%%-*}"; done
    done
    return $falta
  fi

  local o maxola=0
  for id in "${ids[@]}"; do (( ${ola[$id]:-0} > maxola )) && maxola=${ola[$id]}; done
  for (( o=1; o<=maxola; o++ )); do
    echo "Ola $o (en paralelo):"
    for id in "${ids[@]}"; do
      [[ "${ola[$id]:-}" == "$o" ]] || continue
      printf '  %-30s ← %-24s %s\n' "$id" "$( [[ -n "${deps[$id]// /}" ]] && echo "${deps[$id]}" || echo "nada")" "$(estado_de "$id")"
    done
  done
  return $falta
}

cmd_auto() {
  [[ "$MODO" == manual ]] && morir "MODO=manual en slices.conf: usá lanzar / verificar / mergear a mano (o SLICES_MODO=auto)"
  local ids=("$@"); (( ${#ids[@]} )) || mapfile -t ids < <(ids_de_specs)
  (( ${#ids[@]} )) || morir "no hay SPECs en $SPECS"
  echo "slices auto · modo $MODO · lanzador $LANZADOR · ${#ids[@]} slices · máx $MAX_PARALELO a la vez"
  local id e activos listos bloqueados intentos out avance
  while true; do
    activos=0; listos=0; bloqueados=0; avance=""
    for id in "${ids[@]}"; do
      e="$(estado_de "$id")"; out="$(wt_de "$id")/$RECIBOS/$id"
      case "$e" in
        mergeado) listos=$((listos + 1)) ;;
        escalado) bloqueados=$((bloqueados + 1)) ;;
        corriendo|orca) activos=$((activos + 1)) ;;
        cerro)
          if [[ "$MODO" == auto ]]; then
            if ( cmd_mergear "$id" ); then avance=1; listos=$((listos + 1))
            else escalar "$id" "el merge falló (¿conflicto o cambios sin commitear en $RAIZ?)"; bloqueados=$((bloqueados + 1)); fi
          else
            echo "✔ $id cerró. Revisá el diff (git -C $(wt_de "$id") diff $BASE) y: ./slices mergear $id"
            echo "revisar diff y mergear (MODO=semi)" > "$out/escalado"; bloqueados=$((bloqueados + 1))
          fi ;;
        nocerro|cortado|sinlanzar)
          intentos=$(cat "$out/intentos" 2>/dev/null || echo 0)
          if [[ "$e" == nocerro ]] && (( intentos >= MAX_INTENTOS )); then
            escalar "$id" "no cerró en $intentos intentos: el problema está en el SPEC o hace falta una persona"
            bloqueados=$((bloqueados + 1)); continue
          fi
          if ! deps_listas "$id"; then
            local d; for d in $(deps_de "$id"); do
              [[ "$(estado_de "$d")" == escalado || "$d" == *-desconocido ]] && { escalar "$id" "depende de $d, que está trabado"; bloqueados=$((bloqueados + 1)); continue 2; }
            done
            continue
          fi
          (( activos < MAX_PARALELO )) || continue
          if ! ( cmd_lanzar "$id" ); then escalar "$id" "no se pudo lanzar (ver la salida de arriba)"; bloqueados=$((bloqueados + 1)); continue; fi
          mkdir -p "$out"; echo $((intentos + 1)) > "$out/intentos"
          activos=$((activos + 1)); avance=1 ;;
      esac
    done
    if (( listos + bloqueados >= ${#ids[@]} )); then
      echo; cmd_estado
      (( bloqueados )) && { echo "Terminó con $bloqueados slice(s) esperando a una persona (ver ESCALADO)."; return 3; }
      echo "Todos mergeados en $BASE. Siguiente: review en loop, QA y el push/MR (son tuyos)."; return 0
    fi
    if (( activos == 0 )) && [[ -z "$avance" ]]; then
      echo; cmd_estado; echo "Nada para lanzar ni corriendo: revisá las dependencias de los que faltan."; return 3
    fi
    if [[ "$LANZADOR" == orca ]] && (( activos > 0 )); then
      procesar_orca "$(cat "$RAIZ/$RECIBOS/.orca-run" 2>/dev/null)" || return 3
    else
      sleep 20
    fi
  done
}

# ── mergear ─────────────────────────────────────────────────────────────────
cmd_mergear() {
  local id="${1:?uso: slices mergear <id> [--forzar]}" forzar="${2:-}" wt; wt="$(wt_de "$id")"
  local r="$wt/$RECIBOS/$id/recibo.json"
  [[ -d "$wt" ]] || morir "no existe el worktree $wt"
  corriendo "$id" && morir "$id todavía está corriendo"
  if ! grep -q '"cerrado": true' "$r" 2>/dev/null; then
    [[ "$forzar" == "--forzar" ]] || morir "$id no cerró ($(grep -oP '"motivo": "\K[^"]*' "$r" 2>/dev/null || echo "sin recibo")). Si revisaste a mano y vale: ./slices mergear $id --forzar"
  fi
  git -C "$wt" add -A
  git -C "$wt" diff --cached --quiet || git -C "$wt" commit -qm "feat: slice $id"
  local nota; nota="$(grep -q '"cerrado": true' "$r" 2>/dev/null && echo "recibo verde" || echo "forzado: revisado a mano")"
  # La evidencia sin trackear que dejó un `--dry-run` en la raíz estorba al merge.
  git -C "$RAIZ" merge --no-ff -q "slice-$id" -m "merge slice $id ($nota)" \
    || morir "el merge de $id tiene conflictos: resolvelos en $RAIZ y commiteá con el mensaje 'merge slice $id (…)'"
  # Si los recibos están ignorados por git, se perderían con el worktree: se guardan en la raíz.
  if git -C "$wt" check-ignore -q "$RECIBOS/$id/recibo.json" 2>/dev/null; then
    mkdir -p "$RAIZ/$RECIBOS"; cp -r "$wt/$RECIBOS/$id" "$RAIZ/$RECIBOS/" 2>/dev/null || true
  fi
  git -C "$RAIZ" worktree remove --force "$wt"
  git -C "$RAIZ" branch -q -d "slice-$id" 2>/dev/null || true
  echo "$id mergeado a $BASE. El push es tuyo."
}

# ── entrada ─────────────────────────────────────────────────────────────────
case "${1:-ayuda}" in
  init)      shift; cmd_init "$@" ;;
  nuevo)     shift; cmd_nuevo "$@" ;;
  lanzar)    shift; cmd_lanzar "$@" ;;
  estado)    shift; cmd_estado "$@" ;;
  verificar) shift; cmd_verificar "$@" ;;
  mergear)   shift; cmd_mergear "$@" ;;
  auto)      shift; cmd_auto "$@" ;;
  dag)       shift; cmd_dag "$@" ;;
  _trabajar) shift; cmd__trabajar "$@" ;;
  *) sed -n '2,27p' "$YO" | sed 's/^# \{0,1\}//' ;;
esac
